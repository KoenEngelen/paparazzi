<!DOCTYPE module SYSTEM "module.dtd">

<module name="guidance_aerobatic" dir="guidance">
  <doc>
    <description>
      Guidance controller for quadshot using INDI
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="guidance_aerobatic">
        <dl_setting var="guidance_aerobatic_indi_gain" min="0" step="0.1" max="10.0" shortname="G_indi" param="GUIDANCE_GAIN"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="guidance_aerobatic.h"/>
  </header>
  <init fun="guidance_aerobatic_init()"/>
  <periodic fun="guidance_aerobatic_run()" freq="512" autorun="TRUE"/>


  <makefile target="ap|nps" firmware="rotorcraft">
    <file name="guidance_aerobatic.c" dir="$(SRC_FIRMWARE)/guidance"/>
    <define name="GUIDANCE_AEROBATIC" value="TRUE"/>
  </makefile>


</module>
