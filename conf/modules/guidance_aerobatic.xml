<!DOCTYPE module SYSTEM "module.dtd">

<module name="guidance_aerobatic" dir="guidance">
  <doc>
    <description>
      Guidance controller for quadshot using INDI
    </description>
    <section name="GUIDANCE_AEROBATIC" prefix="GUIDANCE_AEROBATIC_">
      <define name="MAX_VEL" value="1.0" description="Maximum velocity allowed during trajectory tracking"/>
      <define name="MAX_ACC" value="1.0" description="Maximum acceleration allowed during trajectory tracking"/>
      <define name="P_GAIN" value="1.0" description="Positional gain of the aerobatic controller"/>
      <define name="D_GAIN" value="1.0" description="Velocity gain of the aerobatic controller"/>
      <define name="MODE" value="0.0" description="Guidance mode: 0 Hover | 1 Trajectory | 2 Impulse"/>
    </section>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="guidance_aerobatic">
        <dl_setting var="varset.max_vel" min="0" step="0.1" max="10.0" shortname="Vmax" param="GUIDANCE_AEROBATIC_MAX_VEL" persistent="true" module="guidance/guidance_aerobatic"/>
        <dl_setting var="varset.max_acc" min="0" step="0.1" max="10.0" shortname="Amax" param="GUIDANCE_AEROBATIC_MAX_ACC" persistent="true"/>
        <dl_setting var="varset.p_gain"  min="0" step="0.1" max="10.0" shortname="Kp"   param="GUIDANCE_AEROBATIC_P_GAIN"  persistent="true"/>
        <dl_setting var="varset.d_gain"  min="0" step="0.1" max="10.0" shortname="Kd"   param="GUIDANCE_AEROBATIC_D_GAIN"  persistent="true"/>
        <dl_setting var="varset.mode"    min="0" step="0.1" max="2.0"  shortname="mode" param="GUIDANCE_AEROBATIC_MODE"    persistent="true"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="guidance_aerobatic.h"/>
  </header>
  <!-- <init fun="guidance_module_h_init()"/> -->
  <!-- <init fun="guidance_aerobatic_enter()"/> -->
  <!-- <periodic fun="guidance_aerobatic_run()" freq="512" autorun="TRUE"/> -->

  <makefile>
    <file name="guidance_aerobatic.c" dir="$(SRC_FIRMWARE)/guidance"/>
  </makefile>

  <makefile target="ap|nps" firmware="rotorcraft">
    <!-- <file name="pprz_matrix_decomp_float.c" dir="math"/> -->
    <define name="GUIDANCE_AEROBATIC" value="TRUE"/>
    <define name="GUIDANCE_V_MODE_MODULE_SETTING" value="GUIDANCE_V_MODE_MODULE"/>
    <define name="GUIDANCE_H_MODE_MODULE_SETTING" value="GUIDANCE_H_MODE_MODULE"/>
  </makefile>


</module>
