<!DOCTYPE module SYSTEM "module.dtd">

<module name="guidance_aerobatic" dir="guidance">
  <doc>
    <description>
      Guidance controller for quadshot using INDI
    </description>
    <section name="GUIDANCE_AEROBATIC" prefix="GUIDANCE_AEROBATIC_">
      <define name="MAX_VEL" value="1.0" description="Maximum velocity allowed during trajectory tracking"/>
      <define name="MAX_ACC" value="1.0" description="Maximum acceleration allowed during trajectory tracking"/>
      <define name="P_GAIN" value="1.0" description="Positional gain of the aerobatic controller"/>
      <define name="D_GAIN" value="1.0" description="Velocity gain of the aerobatic controller"/>
      <define name="Z_P_FACTOR" value="1.0" description="Vertical positional gain of the aerobatic controller"/>
      <define name="Z_D_FACTOR" value="1.0" description="Vertical velocity gain of the aerobatic controller"/>
      <define name="MODE" value="0.0" description="Guidance mode: 0 Hover | 1 Trajectory | 2 Circle"/>
      <define name="USE_FEEDFORWARD" value="FALSE|TRUE" description="enable feedforward acceleration"/>
      <define name="USE_ALT_GAINS" value="FALSE|TRUE" description="enable altitude gains if horizontal gains are disabled"/>
      <define name="USE_FILTERED_OUTPUT" value="FALSE|TRUE" description="use a filter on quaternion output"/>
      <define name="CE_MODE" value="3" description="enable altitude gains if horizontal gains are disabled"/>
      <!-- <define name="MIN_THRUST_EFFECT" value="4.0" description="Minimum value for effectivness"/> -->
    </section>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings NAME="guidance_aerobatic">
        <dl_setting var="varset.max_vel" min="0" step="0.25" max="15.0" shortname="Vmax" param="GUIDANCE_AEROBATIC_MAX_VEL" persistent="true" module="guidance/guidance_aerobatic"/>
        <dl_setting var="varset.max_acc" min="0" step="0.25" max="10.0" shortname="Amax" param="GUIDANCE_AEROBATIC_MAX_ACC" persistent="true"/>
        <dl_setting var="varset.p_gain"  min="0" step="0.25" max="20.0" shortname="Kp"   param="GUIDANCE_AEROBATIC_P_GAIN"  persistent="true"/>
        <dl_setting var="varset.d_gain"  min="0" step="0.25" max="20.0" shortname="Kd"   param="GUIDANCE_AEROBATIC_D_GAIN"  persistent="true"/>
        <dl_setting var="varset.z_p_factor"  min="0" step="0.25" max="20.0" shortname="ZpF"   param="GUIDANCE_AEROBATIC_Z_P_FACTOR"  persistent="true"/>
        <dl_setting var="varset.z_d_factor"  min="0" step="0.25" max="20.0" shortname="ZdF"   param="GUIDANCE_AEROBATIC_Z_D_FACTOR"  persistent="true"/>
        <dl_setting var="varset.mode"    min="0" step="1" max="10"  shortname="mode" values="Hover|Waypoint|Circle" param="GUIDANCE_AEROBATIC_MODE" type="int32" persistent="true"/>
        <dl_setting var="varset.use_feedforward" min="0" step="1" max="1" shortname="feedforward" values="FALSE|TRUE" param="GUIDANCE_AEROBATIC_USE_FEEDFORWARD" type="uint8" persistent="true"/>
        <dl_setting var="varset.use_alt_gains" min="0" step="1" max="1" shortname="alt gains" values="FALSE|TRUE" param="GUIDANCE_AEROBATIC_USE_ALT_GAINS" type="uint8" persistent="true"/>
        <dl_setting var="varset.use_filtered_output" min="0" step="1" max="1" shortname="filter output" values="FALSE|TRUE" param="GUIDANCE_AEROBATIC_USE_FILTERED_OUTPUT" type="uint8" persistent="true"/>
        <dl_setting var="varset.ce_mode" min="1" step="1" max="3" shortname="CE mode" values="3x3|4x4" param="GUIDANCE_AEROBATIC_CE_MODE" type="uint8" persistent="true"/>
        <!-- <dl_setting var="varset.min_thrust_eff"    min="1.0" step="0.1" max="10.0"  shortname="min_eff" param="GUIDANCE_AEROBATIC_MIN_THRUST_EFFECT"    persistent="true"/> -->
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="guidance_aerobatic.h"/>
  </header>
  <!-- <init fun="guidance_module_h_init()"/> -->
  <!-- <init fun="guidance_aerobatic_enter()"/> -->
  <!-- <periodic fun="guidance_aerobatic_run()" freq="512" autorun="TRUE"/> -->

  <makefile>
    <file name="guidance_aerobatic.c" dir="$(SRC_FIRMWARE)/guidance"/>
  </makefile>

  <makefile target="ap|nps" firmware="rotorcraft">
    <!-- <file name="pprz_matrix_decomp_float.c" dir="math"/> -->
    <define name="GUIDANCE_AEROBATIC" value="TRUE"/>
    <define name="GUIDANCE_V_MODE_MODULE_SETTING" value="GUIDANCE_V_MODE_MODULE"/>
    <define name="GUIDANCE_H_MODE_MODULE_SETTING" value="GUIDANCE_H_MODE_MODULE"/>
  </makefile>


</module>
