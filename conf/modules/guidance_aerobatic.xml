<!DOCTYPE module SYSTEM "module.dtd">

<module name="guidance_aerobatic" dir="guidance">
  <doc>
    <description>
      Guidance controller for quadshot using INDI
    </description>
    <section name="GUIDANCE_AEROBATIC" prefix="GUIDANCE_AEROBATIC_">
      <define name="X_OFF" value="0.0" description="Offset in X position"/>
      <define name="Y_OFF" value="0.0" description="Offset in Y position"/>
      <define name="Z_OFF" value="0.0" description="Offset in Z position"/>
      <define name="P_GAIN_X" value="1.0" description="Positional gain of the aerobatic controller"/>
      <define name="V_GAIN_X" value="1.0" description="Velocity gain of the aerobatic controller"/>
      <define name="A_GAIN_X" value="1.0" description="Acceleration gain of the aerobatic controller"/>
      <define name="P_GAIN_Y" value="1.0" description="Positional gain of the aerobatic controller"/>
      <define name="V_GAIN_Y" value="1.0" description="Velocity gain of the aerobatic controller"/>
      <define name="A_GAIN_Y" value="1.0" description="Acceleration gain of the aerobatic controller"/>
      <define name="P_GAIN_Z" value="1.0" description="Positional gain of the aerobatic controller"/>
      <define name="V_GAIN_Z" value="1.0" description="Velocity gain of the aerobatic controller"/>
      <define name="A_GAIN_Z" value="1.0" description="Acceleration gain of the aerobatic controller"/>
      <define name="CTRL_MODE" value="0" description="Guidance mode"/>
      <define name="CTRL_AXIS" value="0" description="Guidance axis"/>
    </section>
  </doc>
  
  <settings>
    <dl_settings>
      <dl_settings NAME="guidance_aerobatic">
        <dl_setting var="my_settings.offset_x"  min="-2.0" step="0.25" max="2.0" shortname="Xoffset" param="GUIDANCE_AEROBATIC_X_OFF"     persistent="true"/>
        <dl_setting var="my_settings.offset_y"  min="-2.0" step="0.25" max="2.0" shortname="Yoffset" param="GUIDANCE_AEROBATIC_Y_OFF"     persistent="true"/>
        <dl_setting var="my_settings.offset_z"  min="-2.0" step="0.25" max="2.0" shortname="Zoffset" param="GUIDANCE_AEROBATIC_Z_OFF"     persistent="true"/>
        <dl_setting var="my_settings.p_gain_x"  min="0"    step="0.25" max="8.0" shortname="Kpx"     param="GUIDANCE_AEROBATIC_P_GAIN_X"  persistent="true"/>
        <dl_setting var="my_settings.v_gain_x"  min="0"    step="0.25" max="8.0" shortname="Kvx"     param="GUIDANCE_AEROBATIC_V_GAIN_X"  persistent="true"/>
        <dl_setting var="my_settings.a_gain_x"  min="0"    step="0.01" max="2.0" shortname="Kax"     param="GUIDANCE_AEROBATIC_A_GAIN_X"  persistent="true"/>
        <dl_setting var="my_settings.p_gain_y"  min="0"    step="0.25" max="8.0" shortname="Kpy"     param="GUIDANCE_AEROBATIC_P_GAIN_Y"  persistent="true"/>
        <dl_setting var="my_settings.v_gain_y"  min="0"    step="0.25" max="8.0" shortname="Kvy"     param="GUIDANCE_AEROBATIC_V_GAIN_Y"  persistent="true"/>
        <dl_setting var="my_settings.a_gain_y"  min="0"    step="0.01" max="2.0" shortname="Kay"     param="GUIDANCE_AEROBATIC_A_GAIN_Y"  persistent="true"/>
        <dl_setting var="my_settings.p_gain_z"  min="0"    step="0.25" max="8.0" shortname="Kpz"     param="GUIDANCE_AEROBATIC_P_GAIN_Z"  persistent="true"/>
        <dl_setting var="my_settings.v_gain_z"  min="0"    step="0.25" max="8.0" shortname="Kvz"     param="GUIDANCE_AEROBATIC_V_GAIN_Z"  persistent="true"/>
        <dl_setting var="my_settings.a_gain_z"  min="0"    step="0.01" max="2.0" shortname="Kaz"     param="GUIDANCE_AEROBATIC_A_GAIN_Z"  persistent="true"/>
        <dl_setting var="my_settings.ctrl_mode"    min="0" step="1" max="5" values="position|velocity|acceleration|attitude|rate|angular" shortname="mode" param="GUIDANCE_AEROBATIC_CTRL_MODE" type="int32" persistent="true"/>
        <dl_setting var="my_settings.ctrl_axis"    min="0" step="1" max="5" values="X|Y|Z|XZ|YZ|None" shortname="axis" param="GUIDANCE_AEROBATIC_CTRL_AXIS" type="int32" persistent="true"/>
         <!-- values="position|velocity|acceleration|attitude|rate|angular"  -->
         <!-- values="X|Y|Z"  -->
      </dl_settings>
    </dl_settings>
  </settings>
  
  <header>
    <file name="guidance_aerobatic.h"/>
  </header>
  
  <makefile>
    <file name="guidance_aerobatic.c" dir="$(SRC_FIRMWARE)/guidance"/>
  </makefile>
  
  <makefile target="ap|nps" firmware="rotorcraft">
    <define name="GUIDANCE_AEROBATIC" value="TRUE"/>
    <define name="GUIDANCE_V_MODE_MODULE_SETTING" value="GUIDANCE_V_MODE_MODULE"/>
    <define name="GUIDANCE_H_MODE_MODULE_SETTING" value="GUIDANCE_H_MODE_MODULE"/>
  </makefile>

</module>
