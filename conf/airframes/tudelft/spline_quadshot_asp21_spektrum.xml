<!--  <servo name="SERVO_TEST" no="5" min="1300" neutral="1500" max="1700"/>  -->
</servos>
<commands>
<axis name="PITCH" failsafe_value="0"/>
<axis name="ROLL" failsafe_value="0"/>
<axis name="YAW" failsafe_value="0"/>
<axis name="THRUST" failsafe_value="0"/>
</commands>
<command_laws>
<set servo="A1" value="autopilot.motors_on ? actuators_pprz[0] : -MAX_PPRZ"/>
<set servo="A2" value="autopilot.motors_on ? actuators_pprz[1] : -MAX_PPRZ"/>
<set servo="B1" value="autopilot.motors_on ? actuators_pprz[2] : -MAX_PPRZ"/>
<set servo="B2" value="autopilot.motors_on ? actuators_pprz[3] : -MAX_PPRZ"/>
<set servo="ELEVON_LEFT" value="autopilot.motors_on ? actuators_pprz[4] : 0"/>
<set servo="ELEVON_RIGHT" value="autopilot.motors_on ? actuators_pprz[5] : 0"/>
</command_laws>
