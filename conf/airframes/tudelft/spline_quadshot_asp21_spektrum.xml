<airframe name="quadshot aspirin 2.1 spektrum">
<description> This is a quadshot vehicle equiped with Lisa/m2.0 and an aspirin 2.1 More information on the Quadshot can be found at transition-robotics.com </description>
<servos driver="Pwm">
<servo name="A1" no="0" min="1000" neutral="1100" max="1600"/>
<servo name="A2" no="1" min="1000" neutral="1100" max="1600"/>
<servo name="B1" no="2" min="1000" neutral="1100" max="1600"/>
<servo name="B2" no="3" min="1000" neutral="1100" max="1600"/>
<servo name="ELEVON_LEFT" no="4" min="1500" neutral="1700" max="1900"/>
