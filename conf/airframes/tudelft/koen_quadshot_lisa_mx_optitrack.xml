  <firmware name="rotorcraft">
    <target name="ap" board="lisa_mx_2.1">
      <module name="radio_control" type="sbus">
        <configure name="SBUS_PORT" value="UART1"/>
        <define name="RADIO_KILL_SWITCH" value="RADIO_AUX1"/>
        <define name="USE_KILL_SWITCH_FOR_MOTOR_ARMING" value="FALSE"/>
      </module>
      <!-- ONLY if flashing via JTAG cable -->
      <configure name="FLASH_MODE"   value="SWD"/>
      <configure name="BMP_PORT" value="/dev/ttyACM0" />
      <!-- To use an airspeed sensor on I2C, enable I2C2-->
      <define name="USE_I2C1"/>
      <define name="USE_SERVOS_7AND8" value ="FALSE"/>
      <!-- If using aspirin 2.2, make sure to uncomment the following barometer configuration: -->
      <!--       <configure name="LISA_M_BARO" value="BARO_MS5611_SPI"/> -->
      <configure name="LISA_M_BARO" value="BARO_BOARD_BMP085"/>
    </target>
    <target name="nps"          board="pc">
      <module name="fdm" type="jsbsim"/>
      <module name="udp"/>
      <module name="radio_control" type="datalink"/>
      <module name="logger_file">
        <define name="FILE_LOGGER_PATH" value="/home/koen/Documents"/>
      </module>
      <define name="MODE_STARTUP"  value="AP_MODE_NAV"/>
      <!--Switch advanced INDI scheduling functions on or off-->
      <!--Take the mode channel for simulation-->
      <define name="INDI_FUNCTIONS_RC_CHANNEL" value="4"/>
    </target>

    <module name="motor_mixing"/>
    <module name="actuators"     type="pwm">
      <define name="SERVO_HZ" value="400"/>
    </module>
    <module name="telemetry"     type="xbee_api"/>
    <module name="imu"           type="lisa_mx_v2.1"/>
    <module name="gps"           type="datalink"/>
    <module name="stabilization" type="indi_simple"/>
    <module name="guidance"      type="aerobatic"/>
    <define name="USE_AHRS_GPS_ACCELERATIONS" value="TRUE"/> <!-- Changed, added-->
    <module name="ahrs"          type="int_cmpl_quat">
      <configure name="USE_MAGNETOMETER" value="FALSE"/>
      <define name="AHRS_USE_GPS_HEADING" value="TRUE"/>
    </module>
    
    <!-- Modules section (depricated modules main_frequency) -->
    <load name="led_safety_status.xml">
          <define name="USE_LED_BODY" value="1"/>
          <define name="SAFETY_WARNING_LED" value="BODY"/>
    </load>

    <!-- <module name="ins"/> -->
    <!-- <module name="ins"  type="hff"/> -->
    <module name="ins"  type="float_invariant"/>

    <module name="airspeed_ms45xx_i2c">
      <define name="MS45XX_I2C_DEV" value="i2c1" />
      <define name="MS45XX_I2C_ADDR" value="0x50" />
      <define name="MS45XX_SYNC_SEND" value="TRUE" />
      <define name="MS45XX_LOWPASS_TAU" value="0.15" />
      <define name="USE_AIRSPEED_MS45XX" value="TRUE" />
    </module>
    <module name="AOA_adc">
      <configure name="ADC_AOA" value="ADC_2"/>
      <define name="AOA_OFFSET" value="-0.135000005364"/>
      <define name="AOA_FILTER" value="0.875999987125"/>
      <define name="USE_AOA"/>
    </module>
    <module name="logger_spi_link">
	    <configure name="HS_LOG_SPI_SLAVE_IDX" value="SPI_SLAVE1"/>
    </module>
    <module name="sys_id_chirp"/>
    <module name="sys_mon"/>

  </firmware>

</airframe>
