    <wingspan unit="IN"> 39.37 </wingspan>
    <chord unit="IN"> 6.40 </chord>
    <htailarea unit="FT2"> 0 </htailarea>
    <htailarm unit="FT"> 0 </htailarm>
    <vtailarea unit="FT2"> 0 </vtailarea>
    <vtailarm unit="FT"> 0 </vtailarm>
    <wing_incidence unit="DEG"> 90 </wing_incidence>
    <location name="AERORP" unit="IN">
        <x> 0 </x>
        <y> 0 </y>
        <z> 0 </z>
    </location>
    <location name="EYEPOINT" unit="IN">
        <x> 0 </x>
        <y> 0 </y>
        <z> 0 </z>
    </location>
    <location name="VRP" unit="IN">
        <x> 0 </x>
        <y> 0 </y>
        <z> 0 </z>
    </location>
</metrics>

<mass_balance> <!-- Inertia and CG -->
    <ixx unit="SLUG*FT2"> 0.0000921215124 </ixx> <!--Ixx = 0.0001249 [kgm2] obtained from Prawien--> 
    <iyy unit="SLUG*FT2"> 0.0000680769864 </iyy> <!--Iyy = 0.0000923 [kgm2] obtained from Prawien-->
    <izz unit="SLUG*FT2"> 0.0000861472590 </izz> <!--Izz = 0.0001168 [kgm2] obtained from Prawien-->
    <ixy unit="SLUG*FT2"> 0. </ixy>
    <ixz unit="SLUG*FT2"> 0. </ixz>
    <iyz unit="SLUG*FT2"> 0. </iyz>
    <emptywt unit="LBS"> 2.2 </emptywt>
    <location name="CG" unit="M">
        <x> 0 </x>
        <y> 0 </y>
        <z> 0 </z>
    </location>
</mass_balance>

  
<ground_reactions>
    <contact type="STRUCTURE" name="CONTACT_FRONT">
        <location unit="M">
            <x>-0.15 </x>
            <y> 0 </y>
            <z>-0.1 </z>
        </location>
        <static_friction>  0.8 </static_friction>
        <dynamic_friction> 0.5 </dynamic_friction>
        <spring_coeff unit="N/M"> 500 </spring_coeff>
        <damping_coeff unit="N/M/SEC"> 100 </damping_coeff>
        <damping_coeff_rebound type="SQUARE" unit="N/M2/SEC2"> 1000 </damping_coeff_rebound>
        <max_steer unit="DEG"> 0.0 </max_steer>
        <brake_group> NONE </brake_group>
        <retractable>0</retractable>
    </contact>

    <contact type="STRUCTURE" name="CONTACT_BACK">
            <location unit="M">
                <x> 0.15</x>
                <y> 0   </y>
                <z>-0.1 </z>
            </location>
            <static_friction>  0.8 </static_friction>
            <dynamic_friction> 0.5 </dynamic_friction>
            <spring_coeff unit="N/M"> 500 </spring_coeff>
            <damping_coeff unit="N/M/SEC"> 100 </damping_coeff>
            <damping_coeff_rebound type="SQUARE" unit="N/M2/SEC2"> 1000 </damping_coeff_rebound>
            <max_steer unit="DEG"> 0.0 </max_steer>
            <brake_group> NONE </brake_group>
            <retractable>0</retractable>
    </contact>

    <contact type="STRUCTURE" name="CONTACT_RIGHT">
        <location unit="M">
            <x> 0.  </x>
            <y> 0.15</y>
            <z>-0.1 </z>
        </location>
        <static_friction>  0.8 </static_friction>
        <dynamic_friction> 0.5 </dynamic_friction>
        <spring_coeff unit="N/M"> 500 </spring_coeff>
        <damping_coeff unit="N/M/SEC"> 100 </damping_coeff>
        <damping_coeff_rebound type="SQUARE" unit="N/M2/SEC2"> 1000 </damping_coeff_rebound>
        <max_steer unit="DEG"> 0.0 </max_steer>
        <brake_group> NONE </brake_group>
        <retractable>0</retractable>
    </contact>

    <contact type="STRUCTURE" name="CONTACT_LEFT">
        <location unit="M">
            <x> 0.  </x>
            <y>-0.15</y>
            <z>-0.1 </z>
        </location>
        <static_friction>  0.8 </static_friction>
        <dynamic_friction> 0.5 </dynamic_friction>
        <spring_coeff unit="N/M"> 500 </spring_coeff>
        <damping_coeff unit="N/M/SEC"> 100 </damping_coeff>
        <damping_coeff_rebound type="SQUARE" unit="N/M2/SEC2"> 1000 </damping_coeff_rebound>
        <max_steer unit="DEG"> 0.0 </max_steer>
        <brake_group> NONE </brake_group>
        <retractable>0</retractable>
    </contact>
</ground_reactions>

<flight_control name="actuator_dynamics"> <!-- Delays in Actuator Dynamics -->
    <channel name="filtering">

        <lag_filter name="mot_A1_lag">
            <input> fcs/mot_A1 </input>
            <c1> 31.7 </c1> <!-- old value-->
            <output> fcs/mot_A1_lag</output>
        </lag_filter>

        <lag_filter name="mot_A2_lag">
            <input> fcs/mot_A2 </input>
            <c1> 31.7 </c1> <!-- old value-->
            <output> fcs/mot_A2_lag</output>
        </lag_filter>

        <lag_filter name="mot_B1_lag">
            <input> fcs/mot_B1 </input>
            <c1> 31.7 </c1> <!-- old value-->
            <output> fcs/mot_B1_lag</output>
        </lag_filter>

        <lag_filter name="mot_B2_lag">
            <input> fcs/mot_B2 </input>
            <c1> 31.7 </c1> <!-- old value-->
            <output> fcs/mot_B2_lag</output>
        </lag_filter>

    </channel>
</flight_control>

<external_reactions> <!-- Addition of Thrust Forces -->

    <property>fcs/mot_A1</property>
    <property>fcs/mot_A2</property>
    <property>fcs/mot_B1</property>
    <property>fcs/mot_B2</property>

    <property>fcs/mot_A1_lag</property>
    <property>fcs/mot_A2_lag</property>
    <property>fcs/mot_B1_lag</property>
    <property>fcs/mot_B2_lag</property>

    <!-- First the lift forces produced by each propeller -->

    <force name="mot_A1" frame="BODY" unit="LBS">
      <function>
        <product>
          <property>fcs/mot_A1_lag</property>
          <value> 1.1 </value> <!-- old value-->
        </product>
      </function>
      <location unit="IN">
        <x>-3.09</x>
        <y>-5.45</y>
        <z> 0   </z>
      </location>
      <direction>
        <x> 0 </x>
        <y> 0 </y>
        <z>-1 </z>
      </direction>
    </force>

    <force name="mot_A2" frame="BODY" unit="LBS">
      <function>
        <product>
          <property>fcs/mot_A2_lag</property>
          <value> 1.1 </value> <!-- old value-->
        </product>
      </function>
      <location unit="IN">
        <x>-3.09</x>
        <y> 5.45</y>
        <z> 0   </z>
      </location>
      <direction>
        <x> 0 </x>
        <y> 0 </y>
        <z>-1 </z>
      </direction>
    </force>

    <force name="mot_B1" frame="BODY" unit="LBS">
      <function>
        <product>
          <property>fcs/mot_B1_lag</property>
          <value> 1.1 </value> <!-- old value-->
        </product>
      </function>
      <location unit="IN">
        <x>  3.09</x>
        <y>-12.93</y>
        <z>  0   </z>
      </location>
      <direction>
        <x> 0</x>
        <y> 0</y>
        <z>-1</z>
      </direction>
    </force>

    <force name="mot_B2" frame="BODY" unit="LBS">
      <function>
        <product>
          <property>fcs/mot_B2_lag</property>
          <value> 1.1 </value> <!-- old value-->
        </product>
      </function>
      <location unit="IN">
        <x> 3.09</x>
        <y>12.93</y>
        <z> 0   </z>
      </location>
      <direction>
        <x> 0</x>
        <y> 0</y>
        <z>-1</z>
      </direction>
    </force>


    <!-- Second the Moment arm produced by all propellers -->


    <force name="mom_arm_z1" frame="BODY" unit="LBS">
      <function>
        <sum>
          <product>
            <sum>
              <property>fcs/mot_B1_lag</property>
              <property>fcs/mot_A2_lag</property>
            </sum>
            <value> 0.35 </value> <!-- old value-->
          </product>
          <product>
            <sum>
              <property>fcs/mot_A1_lag</property>
              <property>fcs/mot_B2_lag</property>
            </sum>
            <value> -0.35 </value> <!-- old value-->
          </product>
        </sum>
      </function>
      <location unit="IN">
        <!-- Necessary arm in IN to produce a moment ten times
        "weaker" then the force when both are measured in the SI is 1.9685 in. -->
        <x>0</x>
        <y>6.8385</y>
        <z>0</z>
      </location>
      <direction>
        <x>-1</x>
        <y>0</y>
        <z>0</z>
      </direction>
    </force>

    <force name="mom_arm_z2" frame="BODY" unit="LBS">
        <function> <!-- f =(mot_B1_lag+mot_A2_lag) * 0.35 + (mot_B2_lag+mot_A1_lag) * -0.35 -->
            <sum>
                <product>
                    <sum>
                        <property>fcs/mot_B1_lag</property>
                        <property>fcs/mot_A2_lag</property>
                    </sum>
                    <value> 0.35 </value> <!-- old value-->
                </product>
                <product>
                    <sum>
                        <property>fcs/mot_A1_lag</property>
                        <property>fcs/mot_B2_lag</property>
                    </sum>
                    <value> -0.35 </value> <!-- old value-->
                </product>
            </sum>
        </function>
        <location unit="IN"> <!-- Necessary arm in IN to produce a moment ten times "weaker" then the force when both are measured in the SI is 1.9685 in. -->
            <x>0</x>
            <y>-6.8385</y>
            <z>0</z>
        </location>
        <direction>
            <x>1</x>
            <y>0</y>
            <z>0</z>
        </direction>
    </force>

</external_reactions>

<propulsion/>

<flight_control name="FGFCS"/>

<aerodynamics>

    <axis name="LIFT">
        <function name="aero/force/Lift_alpha">
        <description>Lift due to alpha</description>
        <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <table>
                <independentVar lookup="row">aero/alpha-rad</independentVar>
                <tableData> <!-- Replace These Values -->
                -1.87 -0.35
                -1.57  0.0
                -1.27  0.65
                -0.80  0.65
                0.00  0.0
                0.80  0.2
                1.27  0.2
                1.57  0.0
                1.87 -0.2
                </tableData>
            </table>
        </product>
        <description>Drag at zero lift</description>
        <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <table>
                <independentVar lookup="row">aero/alpha-rad</independentVar>
                <tableData>
                -1.57    0.4
                -1.27    0.6
                0.00    1.500
                1.27    0.6
                1.57    0.4
                </tableData>
            </table>
        </product>
        </function>

        <function name="aero/force/Drag_induced">
        <description>Induced drag</description>
            <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <property>aero/cl-squared</property>
            <value>0.8</value>
            </product>
        </function>
    </axis></function>
    </axis>

    <axis name="DRAG">
        <function name="aero/force/Drag_basic">
        <description>Drag at zero lift</description>
        <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <table>
                <independentVar lookup="row">aero/alpha-rad</independentVar>
                <tableData>
                -1.57    0.4
                -1.27    0.6
                0.00    1.500
                1.27    0.6
                1.57    0.4
                </tableData>
            </table>
        </product>
        </function>

        <function name="aero/force/Drag_induced">
        <description>Induced drag</description>
            <product>
            <property>aero/qbar-psf</property>
            <property>metrics/Sw-sqft</property>
            <property>aero/cl-squared</property>
            <value>0.8</value>
            </product>
        </function>
    </axis>

</aerodynamics>

</fdm_config>
