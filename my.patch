+    MAKE_MATRIX_PTR(ptrV, Vsvd, COLS_GUIDANCE);
+    MAKE_MATRIX_PTR(ptrB, Bsvd, ROWS_GUIDANCE);
+    MAKE_MATRIX_PTR(ptrX, Xsvd, COLS_GUIDANCE);
+    
