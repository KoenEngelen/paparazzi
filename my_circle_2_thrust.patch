+              m[1] * m[7] * m[10] + 
+              m[5] * m[2] * m[11] - 
+              m[5] * m[3] * m[10] - 
+              m[9] * m[2] * m[7] + 
+              m[9] * m[3] * m[6];
+
+    inv[7] = m[0] * m[6] * m[11] - 
+             m[0] * m[7] * m[10] - 
+             m[4] * m[2] * m[11] + 
+             m[4] * m[3] * m[10] + 
+             m[8] * m[2] * m[7] - 
+             m[8] * m[3] * m[6];
+
+    inv[11] = -m[0] * m[5] * m[11] + 
+               m[0] * m[7] * m[9] + 
+               m[4] * m[1] * m[11] - 
+               m[4] * m[3] * m[9] - 
+               m[8] * m[1] * m[7] + 
+               m[8] * m[3] * m[5];
+
+    inv[15] = m[0] * m[5] * m[10] - 
+              m[0] * m[6] * m[9] - 
+              m[4] * m[1] * m[10] + 
+              m[4] * m[2] * m[9] + 
+              m[8] * m[1] * m[6] - 
+              m[8] * m[2] * m[5];
+
+    det = m[0] * inv[0] + m[1] * inv[4] + m[2] * inv[8] + m[3] * inv[12];
+
+    if (det == 0)
+        return false;
+
+    det = 1.0 / det;
+
+    for (i = 0; i < 16; i++)
+        invOut[i] = inv[i] * det;
+
+    return true;
+}
+void Mat44Vect4Mul(float du[4], const float G_inv[16], const float dv[4]){
+  du[0] = G_inv[0]  * dv[0] + G_inv[1]  * dv[1] + G_inv[2]  * dv[2] + G_inv[3]  * dv[3];
+  du[1] = G_inv[4]  * dv[0] + G_inv[5]  * dv[1] + G_inv[6]  * dv[2] + G_inv[7]  * dv[3];
+  du[2] = G_inv[8]  * dv[0] + G_inv[9]  * dv[1] + G_inv[10] * dv[2] + G_inv[11] * dv[3];
+  du[3] = G_inv[12] * dv[0] + G_inv[13] * dv[1] + G_inv[14] * dv[2] + G_inv[15] * dv[3];
+}
\ No newline at end of file
